{
  "output": {
    "filePath": "repomix.xml",
    "style": "xml",
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": false
  },
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "docs/",
      "resources/",
      "build/",
      "out/",
      "dist/",
      "src/assets/",
      "**/*.svg",
      "**/*.png",
      "**/*.ico",
      "**/*.icns",
      "**/*.md",
      "**/*.yaml",
      "**/*.yml",
      "**/.eslintrc.cjs",
      "eslint.config.mjs",
      "start.sh"
    ]
  }
}
